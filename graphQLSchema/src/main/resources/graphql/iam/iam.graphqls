enum UserRole {
    ROLE_CLIENT
    ROLE_MANAGER
}

type User implements AuditableEntity {
    id: ID!
    username: String!
    email: String!
    role: String!
    isActive: Boolean!
    createdAt: String!
    updatedAt: String!
}

type AuthPayload {
    id: ID!
    username: String!
    email: String!
    accessToken: String!
    refreshToken: String!
}

type ForgotPasswordResponse {
    message: String!
}

type ResetPasswordResponse {
    message: String!
}

type PasswordChangeNotification {
    userId: ID!
    username: String!
    email: String!
    changedAt: String!
    ipAddress: String
    device: String
}

input SignUpInput {
    username: String!
    email: String!
    password: String!
    role: String
}

input SignInInput {
    username: String!
    password: String!
}

input ResetPasswordInput {
    token: String!
    newPassword: String!
}

extend type Query {
    user(id: ID!): User @auth
    users: [User!]! @auth(role: "ROLE_MANAGER")
}

extend type Mutation {
    signUp(input: SignUpInput!): AuthPayload!
    signIn(input: SignInInput!): AuthPayload!
    signOut: Boolean!
    forgotPassword(email: String!): ForgotPasswordResponse!
    resetPassword(input: ResetPasswordInput!): ResetPasswordResponse!
    refreshToken(refreshToken: String!): AuthPayload!
}

extend type Subscription {
    # Notification for when someone changes their password (Security measure)
    passwordChangedAlert(userId: ID!): PasswordChangeNotification! @auth
}

