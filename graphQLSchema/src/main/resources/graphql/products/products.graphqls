enum ProductSortField {
    NAME
    PRICE
    CREATED_AT
    STOCK
    LIKE_COUNT
}

input ProductFilterInput {
    categoryId: ID
    minPrice: Int
    maxPrice: Int
    isActive: Boolean
    search: String
    inStock: Boolean
}

input ProductSortInput {
    field: ProductSortField!
    direction: SortDirection = ASC
}

input CreateProductInput {
    name: String!
    description: String
    price: Int!
    stock: Int!
    categoryIds: [ID!]
    images: [Upload!]
}

input UpdateProductInput {
    name: String
    description: String
    price: Int
    stock: Int
    isActive: Boolean
}

input CreateCategoryInput {
    name: String!
}

input UpdateCategoryInput {
    name: String!
}

extend type Query {
    product(id: ID!): Product
    products(
        page: Int = 0
        size: Int = 20
        filters: ProductFilterInput
        sort: ProductSortInput
    ): ProductPage!
    category(id: ID!): Category
    categories: [Category!]!
    isProductLiked(productId: ID!): Boolean! @auth
}

extend type Mutation {
    createProduct(input: CreateProductInput!): Product! @auth(role: "ROLE_MANAGER")
    updateProduct(id: ID!, input: UpdateProductInput!): Product! @auth(role: "ROLE_MANAGER")
    deleteProduct(id: ID!): Boolean! @auth(role: "ROLE_MANAGER")
    activateProduct(id: ID!): Product! @auth(role: "ROLE_MANAGER")
    deactivateProduct(id: ID!): Product! @auth(role: "ROLE_MANAGER")
    assignCategoryToProduct(productId: ID!, categoryId: ID!): Product! @auth(role: "ROLE_MANAGER")
    uploadProductImage(productId: ID!, file: Upload!, isPrimary: Boolean): ProductImage! @auth(role: "ROLE_MANAGER")
    deleteProductImage(imageId: ID!): Boolean! @auth(role: "ROLE_MANAGER")
    createCategory(input: CreateCategoryInput!): Category! @auth(role: "ROLE_MANAGER")
    updateCategory(id: ID!, input: UpdateCategoryInput!): Category! @auth(role: "ROLE_MANAGER")
    deleteCategory(id: ID!): Boolean! @auth(role: "ROLE_MANAGER")
    likeProduct(productId: ID!): Boolean! @auth(role: "ROLE_CLIENT")
    unlikeProduct(productId: ID!): Boolean! @auth(role: "ROLE_CLIENT")
    decreaseProductStock(productId: ID!, quantity: Int!): Product! @auth
}

type Product implements AuditableEntity {
    id: ID!
    name: String!
    description: String
    price: Money!
    stock: Int!
    isActive: Boolean!
    categoryIds: [ID!]!
    createdByUserId: ID!
    images: [ProductImage!]!
    likeCount: Int!
    isLikedByCurrentUser: Boolean
    isInStock: Boolean!
    categories: [Category!]!
    primaryImage: ProductImage
    createdAt: DateTime!
    updatedAt: DateTime!
}

type ProductPage {
    content: [Product!]!
    totalElements: Int!
    totalPages: Int!
    pageNumber: Int!
    pageSize: Int!
    hasNext: Boolean!
    hasPrevious: Boolean!
}

type ProductImage {
    id: ID!
    productId: ID!
    imageUrl: String!
    isPrimary: Boolean!
    createdAt: DateTime!
}

type Category {
    id: ID!
    name: String!
    createdAt: DateTime!
}

type LowStockAlert {
    product: Product!
    currentStock: Int!
    alertedUserIds: [ID!]!
}
