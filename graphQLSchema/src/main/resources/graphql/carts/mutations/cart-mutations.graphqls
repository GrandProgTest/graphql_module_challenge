extend type Query {
    cart(userId: ID!): Cart @auth
}

extend type Mutation {
    addItemToCart(userId: ID!, input: AddItemToCartInput!): Cart! @auth
    updateCartItemQuantity(userId: ID!, cartItemId: ID!, quantity: Int!): Cart! @auth
    removeItemFromCart(userId: ID!, cartItemId: ID!): Cart! @auth
    updateCartStatus(cartId: ID!, status: CartStatus!): Cart! @auth
}
