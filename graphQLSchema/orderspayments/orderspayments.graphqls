enum OrderStatus {
    PENDING
    PAID
    CANCELLED
}

enum PaymentStatus {
    PENDING
    SUCCEEDED
    FAILED
}

enum WebhookStatus {
    RECEIVED
    PROCESSED
    FAILED
}

type Order implements AuditableEntity {
    id: ID!
    userId: ID!
    cartId: ID
    addressId: ID!
    discountId: ID
    status: OrderStatus!
    totalAmount: Float!
    discountAmount: Float!
    items: [OrderItem!]!
    address: Address!
    discount: Discount
    payment: Payment
    createdAt: String!
    updatedAt: String!
}

type OrderItem {
    id: ID!
    orderId: ID!
    productId: ID!
    priceAtPurchase: Float!
    quantity: Int!
}

type Payment {
    id: ID!
    orderId: ID!
    stripePaymentIntentId: String!
    status: PaymentStatus!
    amount: Float!
    createdAt: String!
}

type PaymentIntentResponse {
    clientSecret: String!
    paymentIntentId: String!
}

type WebhookResponse {
    status: String!
    message: String
}

type StripeWebhook {
    id: ID!
    paymentId: ID
    stripeEventId: String!
    eventType: String!
    payload: String!
    status: WebhookStatus!
    receivedAt: String!
    processedAt: String
}

type Discount {
    id: ID!
    code: String!
    percentage: Int!
    startDate: String!
    endDate: String!
    isActive: Boolean!
    createdAt: String!
}

type Address {
    id: ID!
    userId: ID!
    street: String!
    city: String!
    state: String
    country: String!
    postalCode: String!
    isDefault: Boolean!
    createdAt: String!
}

input CreateDiscountInput {
    code: String!
    percentage: Int!
    startDate: String!
    endDate: String!
}

input CreateAddressInput {
    street: String!
    city: String!
    state: String
    country: String!
    postalCode: String!
    isDefault: Boolean
}

# Orders & Payments Queries
extend type Query {
    order(id: ID!): Order @auth
    orders(userId: ID): [Order!]! @auth
    discount(code: String!): Discount
    activeDiscounts: [Discount!]!
    addresses(userId: ID!): [Address!]! @auth
    address(id: ID!): Address @auth
}

extend type Mutation {
    createOrderFromCart(userId: ID!, addressId: ID!): Order! @auth
    applyDiscountToOrder(orderId: ID!, discountCode: String!): Order! @auth
    removeDiscountFromOrder(orderId: ID!): Order! @auth
    cancelOrder(orderId: ID!): Order! @auth
    createPaymentIntent(orderId: ID!): PaymentIntentResponse! @auth
    handleStripeWebhook(payload: String!): WebhookResponse!
    createAddress(userId: ID!, input: CreateAddressInput!): Address! @auth
    updateAddress(id: ID!, input: CreateAddressInput!): Address! @auth
    deleteAddress(id: ID!): Boolean! @auth
    setDefaultAddress(userId: ID!, addressId: ID!): Address! @auth
    createDiscount(input: CreateDiscountInput!): Discount! @auth(role: "ROLE_MANAGER")
    deactivateDiscount(id: ID!): Discount! @auth(role: "ROLE_MANAGER")
}

# Orders & Payments Subscriptions
extend type Subscription {
    orderCreated(userId: ID): Order! @auth
    orderStatusUpdated(userId: ID, orderId: ID): Order! @auth
}
