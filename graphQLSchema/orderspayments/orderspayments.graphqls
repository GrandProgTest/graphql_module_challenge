type Order implements AuditableEntity {
    id: ID!
    userId: ID!
    cartId: ID
    addressId: ID!
    discountId: ID
    status: OrderStatus!
    totalAmount: Float!
    discountAmount: Float!
    items: [OrderItem!]!
    address: Address!
    discount: Discount
    payment: Payment
    createdAt: String!
    updatedAt: String!
}

type OrderItem {
    id: ID!
    orderId: ID!
    productId: ID!
    priceAtPurchase: Float!
    quantity: Int!
}

enum OrderStatus {
    PENDING
    PAID
    CANCELLED
}

type Payment {
    id: ID!
    orderId: ID!
    stripePaymentIntentId: String!
    status: PaymentStatus!
    amount: Float!
    createdAt: String!
}

enum PaymentStatus {
    PENDING
    SUCCEEDED
    FAILED
}

type PaymentIntentResponse {
    clientSecret: String!
    paymentIntentId: String!
}

type WebhookResponse {
    status: String!
    message: String
}

type StripeWebhook {
    id: ID!
    paymentId: ID
    stripeEventId: String!
    eventType: String!
    payload: String!
    status: WebhookStatus!
    receivedAt: String!
    processedAt: String
}

enum WebhookStatus {
    RECEIVED
    PROCESSED
    FAILED
}

type Discount {
    id: ID!
    code: String!
    percentage: Int!
    startDate: String!
    endDate: String!
    isActive: Boolean!
    createdAt: String!
}

input CreateDiscountInput {
    code: String!
    percentage: Int!
    startDate: String!
    endDate: String!
}

type Address {
    id: ID!
    userId: ID!
    street: String!
    city: String!
    state: String
    country: String!
    postalCode: String!
    isDefault: Boolean!
    createdAt: String!
}

input CreateAddressInput {
    street: String!
    city: String!
    state: String
    country: String!
    postalCode: String!
    isDefault: Boolean
}

# Orders & Payments Queries
extend type Query {
    order(id: ID!): Order
    currentUserOrders: [Order!]!
    orders: [Order!]!

    discount(code: String!): Discount
    activeDiscounts: [Discount!]!

    currentUserAddresses: [Address!]!
    address(id: ID!): Address
}

# Orders & Payments Mutations
extend type Mutation {
    createOrderFromCart(addressId: ID!): Order!
    applyDiscountToOrder(orderId: ID!, discountCode: String!): Order!
    removeDiscountFromOrder(orderId: ID!): Order!
    cancelOrder(orderId: ID!): Order!

    createPaymentIntent(orderId: ID!): PaymentIntentResponse!

    handleStripeWebhook(payload: String!): WebhookResponse!

    createAddress(input: CreateAddressInput!): Address!
    updateAddress(id: ID!, input: CreateAddressInput!): Address!
    deleteAddress(id: ID!): Boolean!
    setDefaultAddress(id: ID!): Address!

    createDiscount(input: CreateDiscountInput!): Discount!
    deactivateDiscount(id: ID!): Discount!
}
