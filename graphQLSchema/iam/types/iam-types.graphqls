type User implements AuditableEntity {
    id: ID!
    username: String!
    email: String!
    role: String!
    isActive: Boolean!
    createdAt: String!
    updatedAt: String!
}

type AuthPayload {
    id: ID!
    username: String!
    email: String!
    accessToken: String!
    refreshToken: String!
}

type ForgotPasswordResponse {
    message: String!
}

type ResetPasswordResponse {
    message: String!
}
