type Query {
    product(id: ID!): Product
    products(
        page: Int = 0
        size: Int = 20
        filters: ProductFilterInput
        sort: ProductSortInput
    ): ProductPage!
    category(id: ID!): Category
    categories: [Category!]!
    isProductLiked(productId: ID!): Boolean! @auth
}

type Mutation {
    createProduct(input: CreateProductInput!): Product! @auth(role: "ROLE_MANAGER")
    updateProduct(id: ID!, input: UpdateProductInput!): Product! @auth(role: "ROLE_MANAGER")
    deleteProduct(id: ID!): Boolean! @auth(role: "ROLE_MANAGER")
    activateProduct(id: ID!): Product! @auth(role: "ROLE_MANAGER")
    deactivateProduct(id: ID!): Product! @auth(role: "ROLE_MANAGER")
    assignCategoryToProduct(productId: ID!, categoryId: ID!): Product! @auth(role: "ROLE_MANAGER")
    uploadProductImage(productId: ID!, file: Upload!, isPrimary: Boolean): ProductImage! @auth(role: "ROLE_MANAGER")
    deleteProductImage(imageId: ID!): Boolean! @auth(role: "ROLE_MANAGER")
    createCategory(input: CreateCategoryInput!): Category! @auth(role: "ROLE_MANAGER")
    updateCategory(id: ID!, input: UpdateCategoryInput!): Category! @auth(role: "ROLE_MANAGER")
    deleteCategory(id: ID!): Boolean! @auth(role: "ROLE_MANAGER")
    likeProduct(productId: ID!): Boolean! @auth(role: "ROLE_CLIENT")
    unlikeProduct(productId: ID!): Boolean! @auth(role: "ROLE_CLIENT")
    decreaseProductStock(productId: ID!, quantity: Int!): Product! @auth
}
