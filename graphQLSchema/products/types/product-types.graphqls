type Product implements AuditableEntity {
    id: ID!
    name: String!
    description: String
    price: Float!
    stock: Int!
    isActive: Boolean!
    categoryIds: [ID!]!
    createdByUserId: ID!
    images: [ProductImage!]!
    likeCount: Int!
    isLikedByCurrentUser: Boolean
    isInStock: Boolean!
    categories: [Category!]!
    primaryImage: ProductImage
    createdAt: String!
    updatedAt: String!
}

type ProductPage {
    content: [Product!]!
    totalElements: Int!
    totalPages: Int!
    pageNumber: Int!
    pageSize: Int!
    hasNext: Boolean!
    hasPrevious: Boolean!
}

type ProductImage {
    id: ID!
    productId: ID!
    imageUrl: String!
    isPrimary: Boolean!
    createdAt: String!
}

type Category {
    id: ID!
    name: String!
    createdAt: String!
}

type LowStockAlert {
    product: Product!
    currentStock: Int!
    alertedUserIds: [ID!]!
}
