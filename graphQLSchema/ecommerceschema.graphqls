interface AuditableEntity {
    id: ID!
    createdAt: String!
    updatedAt: String!
}

type Query {
    product(id: ID!): Product
    products(
        page: Int = 0
        size: Int = 20
        filters: ProductFilterInput
        sort: ProductSortInput
    ): ProductPage!

    category(id: ID!): Category
    categories: [Category!]!

    currentUserCart: Cart

    order(id: ID!): Order
    currentUserOrders: [Order!]!
    orders: [Order!]!

    discount(code: String!): Discount
    activeDiscounts: [Discount!]!

    currentUserAddresses: [Address!]!
    address(id: ID!): Address

    isProductLiked(productId: ID!): Boolean!

    currentUser: User
    user(id: ID!): User
}

type Mutation {
    signUp(input: SignUpInput!): AuthPayload!
    signIn(input: SignInInput!): AuthPayload!
    signOut: Boolean!
    forgotPassword(email: String!): ForgotPasswordResponse!
    resetPassword(input: ResetPasswordInput!): ResetPasswordResponse!
    refreshToken(refreshToken: String!): AuthPayload!

    createProduct(input: CreateProductInput!): Product!
    updateProduct(id: ID!, input: UpdateProductInput!): Product!
    deleteProduct(id: ID!): Boolean!
    activateProduct(id: ID!): Product!
    deactivateProduct(id: ID!): Product!
    assignCategoryToProduct(productId: ID!, categoryId: ID!): Product!
    uploadProductImage(productId: ID!, imageUrl: String!, isPrimary: Boolean): ProductImage!
    deleteProductImage(imageId: ID!): Boolean!

    createCategory(input: CreateCategoryInput!): Category!
    updateCategory(id: ID!, input: UpdateCategoryInput!): Category!
    deleteCategory(id: ID!): Boolean!

    addItemToCart(input: AddItemToCartInput!): Cart!
    updateCartItemQuantity(cartItemId: ID!, quantity: Int!): Cart!
    removeItemFromCart(cartItemId: ID!): Cart!

    likeProduct(productId: ID!): Boolean!
    unlikeProduct(productId: ID!): Boolean!

    createOrderFromCart(addressId: ID!): Order!
    applyDiscountToOrder(orderId: ID!, discountCode: String!): Order!
    removeDiscountFromOrder(orderId: ID!): Order!
    cancelOrder(orderId: ID!): Order!

    createPaymentIntent(orderId: ID!): PaymentIntentResponse!

    handleStripeWebhook(payload: String!): WebhookResponse!

    createAddress(input: CreateAddressInput!): Address!
    updateAddress(id: ID!, input: CreateAddressInput!): Address!
    deleteAddress(id: ID!): Boolean!
    setDefaultAddress(id: ID!): Address!

    createDiscount(input: CreateDiscountInput!): Discount!
    deactivateDiscount(id: ID!): Discount!
}


type Order implements AuditableEntity {
    id: ID!
    userId: ID!
    cartId: ID
    addressId: ID!
    discountId: ID
    status: OrderStatus!
    totalAmount: Float!
    discountAmount: Float!
    items: [OrderItem!]!
    address: Address!
    discount: Discount
    payment: Payment
    createdAt: String!
    updatedAt: String!
}

type OrderItem {
    id: ID!
    orderId: ID!
    productId: ID!
    priceAtPurchase: Float!
    quantity: Int!
}

enum OrderStatus {
    PENDING
    PAID
    CANCELLED
}


type Payment {
    id: ID!
    orderId: ID!
    stripePaymentIntentId: String!
    status: PaymentStatus!
    amount: Float!
    createdAt: String!
}

enum PaymentStatus {
    PENDING
    SUCCEEDED
    FAILED
}

type PaymentIntentResponse {
    clientSecret: String!
    paymentIntentId: String!
}

type WebhookResponse {
    status: String!
    message: String
}

type StripeWebhook {
    id: ID!
    paymentId: ID
    stripeEventId: String!
    eventType: String!
    payload: String!
    status: WebhookStatus!
    receivedAt: String!
    processedAt: String
}

enum WebhookStatus {
    RECEIVED
    PROCESSED
    FAILED
}


type Discount {
    id: ID!
    code: String!
    percentage: Int!
    startDate: String!
    endDate: String!
    isActive: Boolean!
    createdAt: String!
}

input CreateDiscountInput {
    code: String!
    percentage: Int!
    startDate: String!
    endDate: String!
}


type Address {
    id: ID!
    userId: ID!
    street: String!
    city: String!
    state: String
    country: String!
    postalCode: String!
    isDefault: Boolean!
    createdAt: String!
}

input CreateAddressInput {
    street: String!
    city: String!
    state: String
    country: String!
    postalCode: String!
    isDefault: Boolean
}


type Product implements AuditableEntity {
    id: ID!
    name: String!
    description: String
    price: Float!
    stock: Int!
    isActive: Boolean!
    categoryIds: [ID!]!
    createdByUserId: ID!
    images: [ProductImage!]!
    likeCount: Int!
    isLikedByCurrentUser: Boolean
    isInStock: Boolean!
    categories: [Category!]!
    primaryImage: ProductImage
    createdAt: String!
    updatedAt: String!
}

type ProductPage {
    content: [Product!]!
    totalElements: Int!
    totalPages: Int!
    pageNumber: Int!
    pageSize: Int!
    hasNext: Boolean!
    hasPrevious: Boolean!
}

type ProductImage {
    id: ID!
    productId: ID!
    imageUrl: String!
    isPrimary: Boolean!
    createdAt: String!
}

input ProductFilterInput {
    categoryId: ID
    minPrice: Float
    maxPrice: Float
    isActive: Boolean
    search: String
    inStock: Boolean
}

input ProductSortInput {
    field: ProductSortField!
    direction: SortDirection = ASC
}

enum ProductSortField {
    NAME
    PRICE
    CREATED_AT
    STOCK
    LIKE_COUNT
}

enum SortDirection {
    ASC
    DESC
}

input CreateProductInput {
    name: String!
    description: String
    price: Float!
    stock: Int!
    categoryIds: [ID!]
}

input UpdateProductInput {
    name: String
    description: String
    price: Float
    stock: Int
    isActive: Boolean
}

type Category {
    id: ID!
    name: String!
    createdAt: String!
}

input CreateCategoryInput {
    name: String!
}

input UpdateCategoryInput {
    name: String!
}

type Cart implements AuditableEntity {
    id: ID!
    userId: ID!
    status: CartStatus!
    items: [CartItem!]!
    totalItems: Int!
    createdAt: String!
    updatedAt: String!
    checkedOutAt: String
}

type CartItem implements AuditableEntity {
    id: ID!
    productId: ID!
    quantity: Int!
    createdAt: String!
    updatedAt: String!
}

enum CartStatus {
    ACTIVE
    CHECKED_OUT
    ABANDONED
}

input AddItemToCartInput {
    productId: ID!
    quantity: Int!
}

type User implements AuditableEntity {
    id: ID!
    username: String!
    email: String!
    role: String!
    isActive: Boolean!
    createdAt: String!
    updatedAt: String!
}

enum UserRole {
    ROLE_CLIENT
    ROLE_MANAGER
}

type AuthPayload {
    id: ID!
    username: String!
    email: String!
    accessToken: String!
    refreshToken: String!
}

type ForgotPasswordResponse {
    message: String!
}

type ResetPasswordResponse {
    message: String!
}

input SignUpInput {
    username: String!
    email: String!
    password: String!
    role: String
}

input SignInInput {
    username: String!
    password: String!
}

input ResetPasswordInput {
    token: String!
    newPassword: String!
}
