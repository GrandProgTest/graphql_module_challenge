directive @auth(
    role: String
) on FIELD_DEFINITION

scalar Upload

type Query {
    _empty: String
}

type Mutation {
    _empty: String
}

type Subscription {
    _empty: String
}

enum SortDirection {
    ASC
    DESC
}

interface AuditableEntity {
    id: ID!
    createdAt: String!
    updatedAt: String!
}

